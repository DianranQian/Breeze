# ---------------------------------------------------------------------------
# Rust 构建产物
# ---------------------------------------------------------------------------
# 注意：本工作区位于 C:\Spaces\Share\10_Code\10_Bevy\ 之下，而该目录的
# .cargo\config.toml 把 target-dir 重定向到了 C:\Spaces\Share\10_Code\10_Bevy\_build\target。
# 因此这里的 target/ 通常不会出现，但仍然保留规则以防有人改掉那份全局配置。
/target/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# Bevy Studio 运行时产生的文件
# ---------------------------------------------------------------------------
# 这些是编辑器与游戏运行时的临时产物，不进仓库。
*.scene.ron.tmp
*.scene.ron.bak
**/*.scene.ron.tmp
**/*.scene.ron.bak
# 截图与临时抓图工具的输出
.tools/*.bmp
.tools/*.png

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
