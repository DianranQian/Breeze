# ---------------------------------------------------------------------------
# Rust 构建产物
# ---------------------------------------------------------------------------
# 注意：本工作区位于 C:\Spaces\Share\10_Code\10_Bevy\ 之下，而该目录的
# .cargo\config.toml 把 target-dir 重定向到了 C:\Spaces\Share\10_Code\10_Bevy\_build\target。
# 因此这里的 target/ 通常不会出现，但仍然保留规则以防有人改掉那份全局配置。
/target/
# 独立示例是自己的 Cargo 工程，构建产物落在它自己的目录里。
/examples/bevy_debug_demo/target/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# Bevy Studio 运行时产生的文件
# ---------------------------------------------------------------------------
# 这些是编辑器与游戏运行时的临时产物，不进仓库。
*.scene.ron.tmp
*.scene.ron.bak
**/*.scene.ron.tmp
**/*.scene.ron.bak

# 资源稳定标识表（`.breeze/asset_uids.ron`）是**用户项目**的项目数据，
# 应当随项目进版本控制（类似 Unity 的 .meta）。但仓库里的 examples/ 与
# tools/fixtures/ 只是演示与测试夹具：GUI 验收打开它们时会自动生成这张表，
# 那不是示例内容，不该反复出现在 git status 里。
/examples/**/.breeze/
/tools/fixtures/**/.breeze/
/.verify/**/.breeze/

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

/.verify/示例项目/
# GUI 自动验收的运行产物（截图、证据 JSON、报告、隔离的配置目录）
/.verify/runs/

# 仓库根目录下的截图中间产物（可随时重新生成）
/*.raw
/*.size
/*.png
